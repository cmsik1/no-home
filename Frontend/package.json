{
  "name": "no-home-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node --test src/houseSearchParams.test.js src/agentMapping.test.js src/utils/chatPanel.test.js src/utils/houseSearchViewModel.test.js src/services/agentClient.test.js src/services/agentActions.test.js",
    "test:component": "vitest run",
    "test:auto-import": "node --test src/houseSearchParams.test.js",
    "test:widget": "node --test src/utils/chatPanel.test.js",
    "test:agent": "node --test src/agentMapping.test.js src/services/agentClient.test.js src/services/agentActions.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.3",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
