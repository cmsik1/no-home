{
  "name": "no-home-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node --test deployment/vercelConfig.test.js src/houseSearchParams.test.js src/agentMapping.test.js src/utils/chatPanel.test.js src/utils/houseSearchViewModel.test.js src/services/agentClient.test.js src/services/agentActions.test.js src/services/houseService.test.js",
    "test:component": "vitest run",
    "test:auto-import": "node --test src/houseSearchParams.test.js",
    "test:widget": "node --test src/utils/chatPanel.test.js",
    "test:agent": "node --test src/agentMapping.test.js src/services/agentClient.test.js src/services/agentActions.test.js",
    "audit:security": "npm audit --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "^30.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
