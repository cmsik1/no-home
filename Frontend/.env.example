VITE_KAKAO_MAP_API_KEY=
VITE_API_PROXY_TARGET=http://localhost:8080

# Vercel server-side Rewrite target. Set this in the Vercel Dashboard for deployment.
BACKEND_ORIGIN=

# Local builds keep account helpers visible; public Vercel builds omit these variables.
VITE_PASSWORD_RESET_ENABLED=true
VITE_MEMBER_SEARCH_ENABLED=true
