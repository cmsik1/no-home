# Copy this file to .env at the repository root for local development only.
# Production values belong in the Render/Vercel dashboards, never in this file or Git.

# Local PostgreSQL container. These values are consumed by Docker Compose.
POSTGRES_DB=no_home
POSTGRES_USER=no_home
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=5432

# Backend infrastructure. All values are required when the prod profile is active.
# A Neon DB_URL must use jdbc:postgresql:// and TLS options such as sslmode=require.
DB_URL=jdbc:postgresql://localhost:5432/no_home
DB_USERNAME=no_home
DB_PASSWORD=replace-with-local-db-password
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0

# Authentication. Production requires a strong random JWT_SECRET and JWT_COOKIE_SECURE=true.
JWT_SECRET=replace-with-local-jwt-secret-at-least-32-characters
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_TOKEN_SECONDS=604800
JWT_COOKIE_SECURE=false

# Optional Backend integrations. Empty values keep the application buildable and startable;
# only the corresponding public-data, map-server or AI feature remains unavailable.
PUBLIC_DATA_SERVICE_KEY=
PUBLIC_DATA_APT_RENT_SERVICE_KEY=
KAKAO_MAP_API_KEY=
SSAFY_GMS_API_KEY=
SSAFY_GMS_OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
AI_CHAT_MODEL=gpt-4o-mini

# Optional application policy and AI tuning.
NOTICE_ADMIN_EMAILS=admin@nohome.local,admin@example.com
AI_CHAT_MAX_MESSAGE_LENGTH=500
AI_CHAT_RATE_LIMIT_ENABLED=true
AI_CHAT_RATE_LIMIT_REQUESTS=10
AI_CHAT_RATE_LIMIT_WINDOW=1m
AI_CHAT_CONNECT_TIMEOUT=3s
AI_CHAT_READ_TIMEOUT=25s
AI_CHAT_RETRY_MAX_ATTEMPTS=2
AI_CHAT_MEMORY_MAX_MESSAGES=10
AI_CHAT_DIAGNOSTIC_LOGGING_ENABLED=false
AI_CHAT_LOG_LEVEL=INFO
AI_CHAT_DIAGNOSTIC_LOG_LEVEL=OFF

# Frontend build values are embedded in browser assets and therefore are not server secrets.
# Restrict the Kakao JavaScript key by allowed web domain in Kakao Developers.
VITE_KAKAO_MAP_API_KEY=
VITE_API_PROXY_TARGET=http://localhost:8080
